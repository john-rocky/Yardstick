# Session-anchor cells (methodology/continuous-benchmarking-proposal.md §2).
# Every automated session runs its platform's anchors FIRST; cross-session
# comparisons are scored through them (regression_diff.py --anchors).
# Two anchors per platform where two arms exist, so the diff tool can pick an
# anchor whose runtime differs from the engine under test (an anchor measured
# by the engine being bumped is confounded).

ios mlx-swift mlx-community/Qwen3-0.6B-4bit short-chat anchor=1 runs=3
ios litert-lm litert-community/Qwen3-0.6B short-chat anchor=1 runs=3

mac mlx-swift mlx-community/Qwen3-0.6B-4bit short-chat anchor=1 runs=3
mac litert-lm litert-community/Qwen3-0.6B short-chat anchor=1 runs=3

android litert-lm litert-community/Qwen3-0.6B short-chat anchor=1 runs=3 backend=gpu file=qwen3_0_6b_mixed_int4.litertlm
android llama.cpp unsloth/Qwen3-0.6B-GGUF short-chat anchor=1 runs=3 file=Qwen3-0.6B-Q4_K_M.gguf
