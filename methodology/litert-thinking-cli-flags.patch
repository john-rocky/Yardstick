@@ -140,10 +147,27 @@ absl::Status MainHelper(int argc, char** argv) {
   // Create the conversation.
   std::unique_ptr<Conversation> conversation;
   auto session_config = litert::lm::SessionConfig::CreateDefault();
+  if (absl::GetFlag(FLAGS_greedy)) {
+    // Match litert-mac-verify's greedy (topK:1, topP:1.0, temp:0). The CPU
+    // sampler only dispatches type TOP_P, whose impl is combined top-k/top-p —
+    // k=1 makes it argmax.
+    auto& sampler = session_config.GetMutableSamplerParams();
+    sampler.set_type(litert::lm::proto::SamplerParameters::TOP_P);
+    sampler.set_k(1);
+    sampler.set_p(1.0f);
+    sampler.set_temperature(0.0f);
+  }
+  if (absl::GetFlag(FLAGS_max_output_tokens) > 0) {
+    session_config.SetMaxOutputTokens(absl::GetFlag(FLAGS_max_output_tokens));
+  }
+  auto conversation_builder =
+      ConversationConfig::Builder().SetSessionConfig(session_config);
+  if (absl::GetFlag(FLAGS_enable_thinking)) {
+    conversation_builder.SetThinkingConfig(litert::lm::ThinkingConfig(
+        true, absl::GetFlag(FLAGS_thinking_token_budget)));
+  }
   ABSL_ASSIGN_OR_RETURN(auto conversation_config,
-                        ConversationConfig::Builder()
-                            .SetSessionConfig(session_config)
-                            .Build(*engine));
+                        conversation_builder.Build(*engine));
   ABSL_ASSIGN_OR_RETURN(conversation,
